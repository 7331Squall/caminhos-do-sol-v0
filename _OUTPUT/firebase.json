{
  "emulators": {
    "hosting": {
      "port": 5000,
      "host": "localhost",
      "https": {
        "cert": "./ssl/cert.pem",
        "key": "./ssl/key.pem"
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/WebGL/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-transform"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      },
      {
        "source": "**/*.br",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "br"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Cache-Control",
            "value": "no-transform"
          }
        ]
      },
      {
        "source": "**/*.gz",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "gzip"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Cache-Control",
            "value": "no-transform"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/[R|r]odrigo",
        "destination": "/CdS-Test",
        "type": 301
      },
      {
        "source": "/[R|r]odrigo[C|c]lassic",
        "destination": "/CdS-Test",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/[C|c]d[S|s]-[T|t]est",
        "destination": "/CaminhosDoSol/index.html"
      },
      {
        "source": "/",
        "destination": "/Index.html"
      }
    ]
  }
}